{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moabom",
  "version": "0.4.0",
  "identifier": "io.github.moabom",
  "build": {
    "beforeBuildCommand": "npm run build:assets",
    "beforeDevCommand": "npm run dev:assets",
    "frontendDist": "../.generated/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "extensions/": "extensions/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDODI4RTA0OEFGQ0VBOQpSV1NwenE5STRDaklCM1JjRFk0Qi95T2I0SEVSRUdDMGZtdkJJd2FpQkFGQzB5OHN3UHplRHMwNwo=",
      "endpoints": [
        "https://github.com/minsuho/moabom/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
