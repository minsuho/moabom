{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moabom",
  "version": "0.1.0",
  "identifier": "io.github.moabom",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "extensions/": "extensions/"
    }
  }
}
